# ──────────────────────────────────────────────────────────────
# AquaEnhance — environment variables template
# Copy this file to backend/.env and fill in your real values.
# NEVER commit backend/.env to git.
# ──────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────
# Use "mssql" for Microsoft SQL Server (primary)
# Use "mysql" for the docker-compose MySQL fallback
DB_DRIVER=mssql

DB_HOST=localhost\SQLEXPRESS
DB_PORT=1433
DB_NAME=aquaenhance
DB_USER=sa
DB_PASSWORD=Group2project

# ── Storage ────────────────────────────────────────────────────
# Absolute path where uploaded & enhanced images are saved.
# Must persist across server restarts (not a temp folder).
STORAGE_DIR=C:/Users/I7ACHI/STUDY/FINAL_YEAR_PROJECT/UNDERWATER_IMAGE_ENHACEMENT/backend/storage

# ── FastAPI ────────────────────────────────────────────────────
# Change to your deployed domain when you go live.
API_BASE_URL=http://localhost:8000

# ── Frontend ───────────────────────────────────────────────────
# This variable is read by Next.js (must start with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8000
